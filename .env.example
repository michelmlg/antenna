# Antenna — ambiente (copie para .env)

# Canal (caminho no MediaMTX). v1 usava "tvlocal".
CHANNEL=antenna

# Banco SQLite (docker usa file:/app/data/antenna.db)
DATABASE_URL=file:C:/Users/Michel/Desktop/Repos/antenna/data/antenna.db?connection_limit=1&socket_timeout=15

# Fuso da grade de programação
TZ=America/Sao_Paulo

# Playout
AUTOPLAY=true
FALLBACK_MEDIA_ID=

# Worker de playout (API -> comandos) e controle interno
PLAYOUT_PORT=3100
PLAYOUT_URL=http://localhost:3100

# API
API_PORT=3001

# MediaMTX
MEDIA_MTX_URL=rtsp://localhost:8554
MTX_API_URL=http://localhost:9997

# Sync de fontes YouTube (0 desliga)
CONTENT_SYNC_HOURS=6
CONTENT_SYNC_PREWARM_MIN=15

# Se definido, mutations exigem "Authorization: Bearer <token>"
ADMIN_TOKEN=
