# Antenna — configuração central (copie para .env e ajuste).
# Vale para o Docker (docker compose up -d --build, na raiz) e para o dev local.

# ── Canal ────────────────────────────────────────────────────────────────
CHANNEL=antenna                 # caminho no MediaMTX (rtsp://host:8554/antenna)
TZ=America/Sao_Paulo            # fuso da grade de programação
ADMIN_TOKEN=                    # se definido, mutations exigem "Authorization: Bearer <token>"

# ── Portas publicadas no host ─────────────────────────────────────────────
WEB_PORT=3000                   # painel + /api + /hls (nginx) — a porta que você abre
RTSP_PORT=8554                  # VLC etc.
RTMP_PORT=1935
HLS_PORT=8080                   # HLS direto do MediaMTX (opcional)

# ── Dados ────────────────────────────────────────────────────────────────
# Relativos à raiz do repo (ou absolutos). O banco data/antenna.db é criado
# automaticamente no primeiro boot — não há passo manual.
DATA_DIR=./data
MEDIA_DIR=./media

# ── Playout ──────────────────────────────────────────────────────────────
AUTOPLAY=true
FALLBACK_MEDIA_ID=
CONTENT_SYNC_HOURS=6            # sync das fontes YouTube (0 desliga)
CONTENT_SYNC_PREWARM_MIN=15

# ── Dev local (npm run dev:*) ────────────────────────────────────────────
# No Docker estas são internas e fixas no compose; aqui só afetam o host.
API_PORT=3001
PLAYOUT_PORT=3100
WEB_DEV_PORT=5173
PLAYOUT_URL=http://localhost:3100
MEDIA_MTX_URL=rtsp://localhost:8554
MTX_API_URL=http://localhost:9997

# ── Avançado ─────────────────────────────────────────────────────────────
# DATABASE_URL=                 # vazio = derivado de DATA_DIR (recomendado)
