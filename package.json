{
  "name": "antenna",
  "private": true,
  "version": "2.0.0",
  "description": "Antenna — canal de TV linear (playout de YouTube por gênero) na rede local",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @antenna/api",
    "dev:playout": "npm run dev -w @antenna/playout",
    "dev:web": "npm run dev -w @antenna/web",
    "build:web": "npm run build -w @antenna/web",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/database --noEmit && tsc -p packages/core --noEmit && tsc -p apps/api --noEmit && tsc -p apps/playout --noEmit",
    "test": "vitest run",
    "lint": "eslint packages/core/src packages/shared/src apps/api/src apps/playout/src",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "migrate:v1": "tsx packages/database/src/migrate-from-v1.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
